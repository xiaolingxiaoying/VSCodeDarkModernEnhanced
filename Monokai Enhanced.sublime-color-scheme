{
    "name": "Monokai Enhanced",
    "author": "Sublime HQ Pty Ltd, Wimer Hazenberg; Enhanced LSP adaptation",
    "extends": "Packages/Color Scheme - Default/Monokai.sublime-color-scheme",
    "variables": {
        "black": "hsl(0, 0%, 0%)", "black2": "hsl(60, 17%, 11%)", "black3": "hsl(70, 8%, 15%)",
        "blue": "hsl(190, 81%, 67%)", "grey": "hsla(55, 8%, 31%, 0.7)", "orange": "hsl(32, 98%, 56%)",
        "orange2": "hsl(30, 83%, 34%)", "orange3": "hsl(47, 100%, 79%)", "purple": "hsl(261, 100%, 75%)",
        "red": "hsl(0, 93%, 59%)", "red2": "hsl(338, 95%, 56%)", "white": "hsl(0, 0%, 97%)",
        "white2": "hsl(60, 36%, 96%)", "white3": "hsl(60, 30%, 96%)", "yellow": "hsl(54, 70%, 68%)",
        "yellow2": "hsl(80, 76%, 53%)", "yellow3": "hsl(60, 12%, 79%)", "yellow4": "hsl(55, 11%, 22%)", "yellow5": "hsl(50, 11%, 41%)"
    },
    "globals": {
        "foreground": "var(white3)", "background": "var(black3)", "caret": "color(var(white2) alpha(0.9))",
        "block_caret": "color(var(white2) alpha(0.2))", "block_caret_border": "color(var(white2) alpha(0.8))",
        "invisibles": "color(var(white3) alpha(0.35))", "line_highlight": "var(yellow4)", "selection": "var(grey)",
        "selection_border": "var(black2)", "misspelling": "var(red2)", "active_guide": "color(var(orange2) alpha(0.69))",
        "find_highlight_foreground": "var(black)", "find_highlight": "var(orange3)", "brackets_options": "underline",
        "brackets_foreground": "color(var(white3) alpha(0.65))", "bracket_contents_options": "underline",
        "bracket_contents_foreground": "color(var(white3) alpha(0.65))", "tags_options": "stippled_underline"
    },
    "rules": [
        {"scope": "comment", "foreground": "var(yellow5)"},
        {"scope": "string, meta.embedded.assembly", "foreground": "var(yellow)"},
        {"scope": "constant.numeric, constant.language, constant.character, constant.other.option", "foreground": "var(purple)"},
        {"scope": "constant.regexp, string.regexp, constant.character.character-class.regexp, constant.other.character-class.set.regexp, constant.other.character-class.regexp, constant.character.set.regexp", "foreground": "var(red)"},
        {"scope": "keyword, storage, storage.modifier, keyword.operator.new, keyword.operator.expression, keyword.operator.cast, keyword.operator.sizeof, keyword.operator.alignof, keyword.operator.typeid, keyword.operator.alignas, keyword.operator.instanceof, keyword.operator.logical.python, keyword.operator.wordlike", "foreground": "var(red2)"},
        {"scope": "keyword.operator", "foreground": "var(white3)"},
        {"scope": "storage.type, support.class, support.type, entity.name.type, entity.name.interface, entity.name.struct, entity.name.enum, entity.name.type.alias, entity.name.namespace, variable.other.namespace, entity.other.inherited-class", "foreground": "var(blue)", "font_style": "italic"},
        {"scope": "entity.name.function, variable.function, meta.function-call entity.name.function, meta.function-call variable.function, support.function, support.function.builtin, support.constant.handlebars, entity.name.operator.custom-literal", "foreground": "var(yellow2)"},
        {"scope": "entity.name.tag, meta.mapping.key string.unquoted", "foreground": "var(red2)"},
        {"scope": "entity.other.attribute-name, entity.other.attribute", "foreground": "var(yellow2)"},
        {"scope": "variable.language, variable.parameter", "foreground": "var(orange)", "font_style": "italic"},
        {"scope": "variable.other.constant, constant.other.enum, constant.other.enummember, variable.other.enummember", "foreground": "var(purple)"},
        {"scope": "variable.other.member, variable.other.property, meta.object-literal.key, meta.mapping.key, meta.mapping.key string, meta.structure.dictionary.key.python, support.variable, entity.name.variable, constant.other.placeholder", "foreground": "var(white3)"},
        {"scope": "support.type.vendored.property-name, support.type.property-name, source.css variable, source.coffee.embedded", "foreground": "var(blue)"},
        {"scope": "invalid", "foreground": "var(white2)", "background": "var(red2)"},
        {"scope": "invalid.deprecated", "foreground": "var(white2)", "background": "var(purple)"},
        {"scope": "markup.underline", "font_style": "underline"},
        {"scope": "markup.bold, markup.heading, markup.heading entity.name.section", "font_style": "bold"},
        {"scope": "markup.italic", "font_style": "italic"},
        {"scope": "markup.strikethrough", "font_style": "stippled_underline"},
        {"scope": "markup.inserted", "foreground": "var(yellow2)"}, {"scope": "markup.deleted", "foreground": "var(red2)"}, {"scope": "markup.changed", "foreground": "var(yellow)"},
        {"name": "Markdown links and URLs", "scope": "markup.underline.link, markup.underline.link.image, string.other.link, meta.link.inline string, meta.link.reference string", "foreground": "var(blue)"},
        {"name": "Markdown list and quote markers", "scope": "punctuation.definition.list_item.markdown, markup.list.numbered.bullet.markdown, markup.list.unnumbered.bullet.markdown, punctuation.definition.blockquote.markdown, punctuation.definition.quote, punctuation.definition.heading.markdown", "foreground": "var(orange)"},
        {"name": "Markdown fenced code punctuation", "scope": "punctuation.definition.raw.code-fence, punctuation.definition.raw.begin.markdown, punctuation.definition.raw.end.markdown, punctuation.definition.fenced.markdown, meta.code-fence.definition.markdown-gfm", "foreground": "var(yellow5)"},
        {"name": "Markdown table punctuation", "scope": "punctuation.separator.table-cell.markdown, punctuation.section.table-header.markdown, punctuation.definition.table-cell-alignment.markdown", "foreground": "color(var(white) alpha(0.67))"},
        {"name": "Markdown block quotes", "scope": "markup.quote, markup.quote punctuation", "foreground": "var(yellow5)"},
        {"name": "LaTeX commands", "scope": "support.function.general.latex, support.function.internal.latex, support.function.general.tex, support.function.internal.tex, entity.name.newcommand.latex", "foreground": "var(yellow2)"},
        {"name": "LaTeX environments and sections", "scope": "entity.name.environment.latex, entity.name.section.latex, entity.name.section.tex, support.class.latex, variable.parameter.function.latex", "foreground": "var(blue)", "font_style": "italic"},
        {"name": "LaTeX references and citations", "scope": "constant.other.reference.latex, constant.other.citation.latex, variable.other.reference.latex, variable.other.citation.latex, entity.name.label.latex", "foreground": "var(purple)"},
        {"name": "LaTeX parameters", "scope": "variable.parameter.latex, variable.parameter.tex, variable.other.macro.tex", "foreground": "var(orange)", "font_style": "italic"},
        {"name": "LaTeX math operators", "scope": "keyword.operator.math.latex, keyword.operator.math.tex, support.function.math.latex, support.function.math.tex", "foreground": "var(white3)"},
        {"name": "LaTeX group punctuation", "scope": "punctuation.definition.group.latex, punctuation.definition.group.tex, punctuation.definition.brackets.latex, punctuation.definition.brackets.tex", "foreground": "var(white3)"},
        {"name": "LSP semantic highlighting activation", "scope": "meta.semantic-token", "background": "#00000101"},
        {"name": "Semantic functions", "scope": "meta.semantic-token.function, meta.semantic-token.method, meta.semantic-token.event", "foreground": "var(yellow2)"},
        {"name": "Semantic macros", "scope": "meta.semantic-token.macro", "foreground": "var(red2)"},
        {"name": "Semantic types", "scope": "meta.semantic-token.type, meta.semantic-token.class, meta.semantic-token.interface, meta.semantic-token.struct, meta.semantic-token.enum, meta.semantic-token.namespace, meta.semantic-token.typeparameter", "foreground": "var(blue)", "font_style": "italic"},
        {"name": "Semantic variables", "scope": "meta.semantic-token.variable, meta.semantic-token.parameter, meta.semantic-token.property", "foreground": "var(white3)"},
        {"name": "Semantic enum members", "scope": "meta.semantic-token.enummember", "foreground": "var(purple)"},
        {"name": "Semantic keywords", "scope": "meta.semantic-token.keyword, meta.semantic-token.modifier", "foreground": "var(red2)"},
        {"name": "Semantic comments", "scope": "meta.semantic-token.comment", "foreground": "var(yellow5)"},
        {"name": "Semantic strings", "scope": "meta.semantic-token.string", "foreground": "var(yellow)"},
        {"name": "Semantic numbers", "scope": "meta.semantic-token.number", "foreground": "var(purple)"},
        {"name": "Semantic regular expressions", "scope": "meta.semantic-token.regexp", "foreground": "var(red)"},
        {"name": "Semantic operators", "scope": "meta.semantic-token.operator", "foreground": "var(white3)"},
        {"name": "Semantic decorators", "scope": "meta.semantic-token.decorator", "foreground": "var(yellow2)"},
        {"name": "Semantic labels", "scope": "meta.semantic-token.label", "foreground": "var(orange)"},
        {"name": "Semantic readonly values", "scope": "meta.semantic-token.variable.readonly, meta.semantic-token.parameter.readonly, meta.semantic-token.property.readonly", "foreground": "var(purple)"},
        {"name": "VS Code semantic token: newOperator", "scope": "meta.semantic-token.newoperator", "foreground": "var(red2)"},
        {"name": "VS Code semantic token: stringLiteral", "scope": "meta.semantic-token.stringliteral", "foreground": "var(yellow)"},
        {"name": "VS Code semantic token: customLiteral", "scope": "meta.semantic-token.customliteral", "foreground": "var(yellow2)"},
        {"name": "VS Code semantic token: numberLiteral", "scope": "meta.semantic-token.numberliteral", "foreground": "var(purple)"}
    ]
}
